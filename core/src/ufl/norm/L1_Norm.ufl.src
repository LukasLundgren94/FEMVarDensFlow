#------------------------------------------------
# UFL definition 

Q = FiniteElement("Lagrange", cell, degree_cg)
Q_ex = FiniteElement("Lagrange", cell, degree_cg + 2)

# Dimension of domain
d = cell.topological_dimension()

u   = Coefficient(Q)
u_ex   = Coefficient(Q_ex)

err = abs(u-u_ex)

M = err * dx
#------------------------------------------------

