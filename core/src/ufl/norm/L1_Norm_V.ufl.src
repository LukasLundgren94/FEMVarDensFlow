#------------------------------------------------
# UFL definition 

Q = VectorElement("Lagrange", cell, degree_cg)
Q_ex = VectorElement("Lagrange", cell, degree_cg + 2)

# Dimension of domain
d = cell.topological_dimension()

u   = Coefficient(Q)
u_ex   = Coefficient(Q_ex)

err = u-u_ex

if d==1:
   M = abs(err[0]) * dx
elif d==2:
   M = abs(err[0]) * dx + abs(err[1]) * dx 
elif d==3:
   M = abs(err[0]) * dx + abs(err[1]) * dx + abs(err[2]) * dx 

#------------------------------------------------

