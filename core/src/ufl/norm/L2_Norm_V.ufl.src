#------------------------------------------------
# UFL definition 

Q = VectorElement("Lagrange", cell, degree_cg)
Q_ex = VectorElement("Lagrange", cell, degree_cg + 2)

# Dimension of domain
d = cell.topological_dimension()

u   = Coefficient(Q)
u_ex   = Coefficient(Q_ex)

err = (u - u_ex)

M = inner(err, err) * dx
#------------------------------------------------

