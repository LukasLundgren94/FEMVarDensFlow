#------------------------------------------------
# UFL definition 

Q = FiniteElement("Lagrange", cell, degree_cg)
V = VectorElement("Lagrange", cell, degree_cg)
vDG = VectorElement("Discontinuous Lagrange", cell, 0)

# Dimension of domain
d = cell.topological_dimension()

v   = TestFunction(V)
U   = TrialFunction(V)

h   = Coefficient(vDG)
u   = Coefficient(V)

weight = Constant(cell)

lapl = 0
for ii in range(0,d):
    lapl = lapl + h[ii]* U[i].dx(ii) * v[i].dx(ii)

#a = inner(U,v)*dx + weight*inner(h, h)*inner(grad(U), grad(v))*dx
a = inner(U,v)*dx + lapl*weight*dx
L = inner(u,v)*dx

#------------------------------------------------

