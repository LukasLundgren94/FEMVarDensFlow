#------------------------------------------------
# UFL definition 

Q = FiniteElement("Lagrange", cell, degree_cg)
V = VectorElement("Lagrange", cell, degree_cg)
DG = FiniteElement("Discontinuous Lagrange", cell, 0)

# Dimension of domain
d = cell.topological_dimension()

v   = TestFunction(V)
U   = TrialFunction(V)

u   = Coefficient(V)
h   = Coefficient(Q)

weight = Constant(cell)

a = inner(U,v)*dx + weight*h*h*inner(grad(U), grad(v))*dx
L = inner(u,v)*dx

#------------------------------------------------

