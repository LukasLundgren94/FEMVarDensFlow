#------------------------------------------------
# UFL definition 

Q = FiniteElement("Lagrange", cell, degree_cg)
V = VectorElement("Lagrange", cell, degree_cg)
vDG = VectorElement("Discontinuous Lagrange", cell, 0)

# Dimension of domain
d = cell.topological_dimension()

v   = TestFunction(V)
U   = TrialFunction(V)

h   = Coefficient(V)
u   = Coefficient(V)

weight = Constant(cell)

if d == 2:
   H = as_matrix( ((h[0]**2, 0), (0, h[1]**2)) )
elif d == 3:
   H = as_matrix( ((h[0]**2, 0, 0), (0, h[1]**2, 0), (0, 0, h[2]**2)) )

a = inner(U,v)*dx + weight*inner(dot(H,grad(U)), grad(v))*dx
L = inner(u,v)*dx

#------------------------------------------------

