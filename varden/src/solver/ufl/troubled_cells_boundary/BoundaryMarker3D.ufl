element = FiniteElement("Lagrange", tetrahedron, 1)

degree_V_M = 3  # fixme fix poldegree
V = VectorElement("Lagrange", tetrahedron, degree_V_M)
h = Coefficient(V)
diag_h = diag(h)

u = TrialFunction(element)
v = TestFunction(element)

cd = CellVolume(tetrahedron)
h_ = pow(cd, 1/3)
diag_h_ = as_matrix([[h_, 0, 0],
                     [0, h_, 0],
                     [0, 0, h_]])

C_directional = Constant(tetrahedron)
weight = Constant(tetrahedron)

stab = degree_V_M*degree_V_M*weight*(C_directional*diag_h*diag_h + (1-C_directional)*diag_h_*diag_h_)

# a = u*v*dx + 1e15*u*v*ds + h*h*inner(grad(u), grad(v))*dx
a = u*v*dx + 1e15*u*v*ds + inner(stab*grad(u), grad(v))*dx
L = -1*v*dx + 1e15*v*ds 

